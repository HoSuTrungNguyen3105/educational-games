# ─────────────────────────────────────────────────────────────
# Copy file này thành .env rồi điền giá trị thật.
# .env ĐÃ được git-ignore — KHÔNG commit khoá thật vào đây.
# ─────────────────────────────────────────────────────────────

MONGODB_URI=mongodb://<user>:<password>@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017/?authSource=admin&replicaSet=atlas-xxxx&tls=true
MONGODB_DB=educational_games
PORT=5000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# REFRESH TOKEN (chi tiết: update_refresh_token.md)
#
# Access token: vẫn là JWT ở trên, client giữ trong BỘ NHỚ và gửi qua header
# Authorization. Muốn phiên chặt hơn thì đặt JWT_EXPIRES_IN=15m — client tự
# refresh trước khi hết hạn, người dùng không phải đăng nhập lại.
#
# Refresh token: JWT kiểu "refresh", nằm trong cookie HttpOnly, server chỉ lưu
# HASH. Đổi secret riêng ở đây để một leaked JWT_SECRET không forged được cả hai.
# REFRESH_SECRET=
# REFRESH_TOKEN_EXPIRES_IN=30d
#
# Origin được phép gọi /api/auth/refresh (so khớp tuyệt đối scheme+host+port,
# phân cách bởi dấu phẩy). Khai báo THIẾU ⇒ chỉ dev localhost, không mở toang.
# REFRESH_ALLOWED_ORIGINS=https://domain-production-cua-ban.com,http://localhost:5173
#
# Cookie: mặc định tự chọn theo NODE_ENV
#   production → SameSite=None + Secure (frontend github.io ≠ API onrender.com)
#   dev        → SameSite=Lax, không Secure (http://localhost)
# Chỉ ghi đè khi biết rõ mình đang làm gì:
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_NAME=edu_refresh
#
# Client không phải trình duyệt (curl/test) thường không gửi header Origin và bị
# từ chối. Chỉ bật khi backend thật sự cần machine client refresh.
# REFRESH_ALLOW_NO_ORIGIN=false
# ─────────────────────────────────────────────────────────────

SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─────────────────────────────────────────────────────────────
# Lưu trữ HTML game — templates.htmlTemplate lưu link tải
#
# Chọn MỘT trong hai cách. Service tự ưu tiên R2 trước Firebase.
# Xem `npm run check:storage` để biết đang dùng cái nào.
# ─────────────────────────────────────────────────────────────

# [A] Cloudflare R2 — 10GB free, KHÔNG cần billing Firebase
#     console.r2.cloudflare.com → tạo bucket → Manage R2 API Tokens
#     → Create API Token → Object Read & Write
#     → bật "Public access" để lấy link https://pub-xxxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# [B] Firebase Storage — CẦN nâng gói lên Blaze
#     Firebase Console → Usage & billing → Storage → Get started
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@xxxx.iam.gserviceaccount.com
# Dùng \n giữa các dòng của private key, ví dụ:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ─────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (push notification)
# Dùng SDK web trong frontend — không cần private key.
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_MESSAGING_SENDER_ID=

# ─────────────────────────────────────────────────────────────
# Cloudinary
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ─────────────────────────────────────────────────────────────────────
# AI Service (Java, mac dinh :8081)
#
# Kien truc:  Frontend → Backend chính (file nay) → AI Service
# Frontend KHONG bao gio goi thang AI Service.
#
# AI_BACKEND_TOKEN la shared secret gui qua header X-Ai-Internal-Token.
# PHAI khop voi EDU_AI_INTERNAL_TOKEN cua AI Service. Neu de trong, moi
# chuc nang AI se tra 503 kem huong dan cau hinh.
#
# KHI DEPLOY: localhost trong container KHONG phai may chay Backend chinh.
# Phai tro sang URL that cua AI Service (va nen dat AI Service trong mang
# noi bo neu co the).
# ─────────────────────────────────────────────────────────────────────
AI_BACKEND_URL=http://localhost:8081
AI_BACKEND_TOKEN=
AI_BACKEND_TIMEOUT_MS=120000
# Dat false de tat toan bo chuc nang AI (truong hop khong co AI Service).
AI_BACKEND_ENABLED=true