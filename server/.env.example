# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=educational_games
PORT=5000

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Socket.IO CORS — danh sách origin được phép kết nối (phân tách bằng dấu phẩy).
# Để trống = cho phép mọi origin (chỉ nên dùng khi dev).
SOCKET_CORS_ORIGINS=https://ho-nguyen.github.io

# Firebase Cloud Messaging (for push notifications)
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key" and save as server/firebase-service-account.json
# 3. Or set FIREBASE_PROJECT_ID to use Application Default Credentials
FIREBASE_PROJECT_ID=eduplay-74301
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
