# ── Edu Game AI Service (Java) ───────────────────────────────────
# File này được AI Service nạp khi khởi động (xem edu.ai.env-file).
# Sao chép thành `.env` rồi điền giá trị thật. `.env` đã được gitignore.

# ── Ollama ───────────────────────────────────────────────────────
# Endpoint Ollama. Ollama local thường là http://localhost:11434.
# Dịch vụ từ xa (vd ollama.com) dùng endpoint riêng của hạ tầng đó.
OLLAMA_BASE_URL=http://localhost:11434

# Tên model. Phải có sẵn ở endpoint: `ollama pull <model>`.
# Ưu tiên model có hỗ trợ tiếng Việt tốt, ví dụ: qwen3, llama3.1, gemma3.
OLLAMA_MODEL=qwen3:8b

# API key của endpoint.
#   - ĐỂ TRỐNG khi dùng Ollama local (không cần xác thực).
#   - Điền khi endpoint từ xa yêu cầu key.
# TUYỆT ĐỐI không ghi key thật vào file này, không log ra console, không đưa
# lên frontend. Nếu đã lỡ commit key vào git thì phải rotate key đó.
OLLAMA_KEY=

# Timeout gọi model (ms). Model local sinh câu hỏi có thể mất 30–90 giây.
OLLAMA_CONNECT_TIMEOUT=10000
OLLAMA_READ_TIMEOUT=120000
OLLAMA_TEMPERATURE=0.4

# ── Bảo mật ─────────────────────────────────────────────────────
# Kien truc:  Frontend → Backend chính (:5000) → AI Service (file nay)
# AI Service KHÔNG nhận request trực tiếp từ trình duyệt.
#
# EDU_AI_INTERNAL_TOKEN: shared secret Backend chính gửi qua header
# X-Ai-Internal-Token. Rỗng = TẮT chế độ service-to-service (chỉ còn
# chế độ legacy Bearer). TUYỆT ĐỐI lấy từ biến môi trường, không hard-code,
# không log, không trả về cho client.
# PHẢI khớp với AI_BACKEND_TOKEN của Backend chính.
EDU_AI_INTERNAL_TOKEN=

# Cho phép xác thực bằng Bearer token của người dùng (cách cũ — chỉ để dev/test
# hoặc gọi thử trực tiếp). Đặt false ở production: khi đó AI Service CHỈ nhận
# request có service token từ Backend chính.
EDU_AI_LEGACY_BEARER_AUTH=true

# Chỉ áp dụng cho chế độ legacy. true = mọi endpoint /api/ai/** trừ health đều
# cần Bearer token hợp lệ. false CHỈ để chạy thử nhanh khi chưa có backend.
EDU_AI_AUTH_REQUIRED=true

# Chỉ giáo viên/admin được sinh câu hỏi bằng AI.
EDU_AI_QUIZ_REQUIRES_STAFF=true

# Origin được phép gọi TRỰC TIẾP AI Service. Mặc định chỉ localhost:5000
# (Backend chính) + cổng Vite dev. Không phải cơ chế bảo vệ API — ràng buộc thật
# sự là service token; production nên đặt AI Service trong mạng nội bộ.
# EDU_AI_ALLOWED_ORIGINS=https://ho-nguyen.github.io

# Tắt cơ chế nạp file .env (dùng khi deploy với secrets của nền tảng).
# EDU_AI_ENV_FILE=-

# ── Chống spam ───────────────────────────────────────────────────
EDU_AI_RATE_LIMIT_ENABLED=true
EDU_AI_RATE_LIMIT_CHAT=20
# Giải thích câu trả lời sai — hạn mức riêng vì mỗi lượt đều gọi LLM.
EDU_AI_RATE_LIMIT_EXPLAIN=30
EDU_AI_RATE_LIMIT_QUIZ=10
EDU_AI_RATE_LIMIT_ANALYSIS=10

# Số lần thử lại khi AI trả JSON hỏng (không lặp vô hạn).
EDU_AI_JSON_RETRY=1

# ── Backend nghiệp vụ (Node/Express) ─────────────────────────────
# CHỈ dùng cho CHẾ ĐỘ LEGACY (gọi thẳng AI Service khi dev, không qua Backend
# chính). Trong luồng chuẩn, Backend chính truyền dữ liệu xuống qua request.
# AI Service không có database riêng.
CORE_API_BASE=http://localhost:5000/api
EDU_CORE_ENABLED=true